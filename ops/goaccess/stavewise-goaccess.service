# Writes the GoAccess report of stavewise.app (#600). Started hourly by
# stavewise-goaccess.timer. Install both to /etc/systemd/system/ and enable
# the timer: systemctl enable --now stavewise-goaccess.timer
#
# The report goes to /opt/stavewise/goaccess/report.html, outside the site
# root /opt/stavewise/web, so it is not public (#591 open question 5); fetch
# it with scp. Reads today's and yesterday's log (*.log.1 stays uncompressed
# by delaycompress), so the lines after the last run before a rotation are not
# lost; GoAccess skips what it has already counted.
[Unit]
Description=GoAccess report for stavewise.app
After=nginx.service

[Service]
Type=oneshot
ExecStartPre=/usr/bin/mkdir -p /opt/stavewise/goaccess/db
ExecStart=/bin/sh -c 'exec /usr/bin/goaccess --config-file=/etc/goaccess/stavewise.conf --output=/opt/stavewise/goaccess/report.html $(ls /var/log/nginx/stavewise.app.access.log.1 /var/log/nginx/stavewise.app.access.log 2>/dev/null)'
Nice=10
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/stavewise/goaccess
NoNewPrivileges=true
