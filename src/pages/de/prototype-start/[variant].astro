---
// PROTOTYPE (#709): home page with guide links in three variants, /de/prototype-start/a|b|c.
import ProtoBase from '../../../components/prototype/ProtoBase.astro';
import StartProto from '../../../components/prototype/StartProto.astro';
import { home } from '../../../texts/home';

export const getStaticPaths = () => ['a', 'b', 'c'].map((variant) => ({ params: { variant } }));
const variant = Astro.params.variant as 'a' | 'b' | 'c';
const t = home.de;
---
<ProtoBase title={t.title} description={t.description} variant={variant} kind="start">
  <StartProto lang="de" variant={variant} />
</ProtoBase>
