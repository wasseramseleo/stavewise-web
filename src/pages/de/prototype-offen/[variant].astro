---
// PROTOTYPE (stavewise#825): home page once the open test is live, /de/prototype-offen/a|b|c.
import ProtoBase from '../../../components/prototype/ProtoBase.astro';
import ProtoHome from '../../../components/prototype/ProtoHome.astro';
import { home } from '../../../texts/home';
import { VARIANTS, type Variant } from '../../../texts/prototype-offen';

export const getStaticPaths = () => VARIANTS.map((variant) => ({ params: { variant } }));
const variant = Astro.params.variant as Variant;
---
<ProtoBase lang="de" title={home.de.title} variant={variant} kind="start">
  <ProtoHome lang="de" variant={variant} />
</ProtoBase>
