---
// PROTOTYPE (#709): Open Graph preview image, one per language for all pages,
// 1200 x 630, three variants. Rendered as HTML and screenshotted to PNG.
import { Image } from 'astro:assets';
import '../../styles/tokens.css';
import '../../styles/base.css';
import Wordmark from '../../components/Wordmark.astro';
import Switcher from '../../components/prototype/Switcher.astro';
import shotDe from '../../assets/screenshots/de/exercise-hero.png';

export const getStaticPaths = () =>
  ['de', 'en'].flatMap((lang) => ['a', 'b', 'c'].map((v) => ({ params: { id: `${lang}-${v}` } })));
const [lang, variant] = (Astro.params.id as string).split('-');
const text = {
  de: { claim: 'Noten lesen lernen, indem du sie spielst.', sub: 'Am E-Piano · Android · USB und Bluetooth-MIDI' },
  en: { claim: 'Learn to read music by playing it.', sub: 'On your digital piano · Android · USB and Bluetooth MIDI' },
}[lang as 'de' | 'en'];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=1240" />
    <meta name="robots" content="noindex" />
    <title>OG {Astro.params.id}</title>
    <style is:global>
      body { background: #888; margin: 0; padding: 20px; }
      .og { width: 1200px; height: 630px; overflow: hidden; position: relative; font-family: var(--sans); color-scheme: light;
        --background: #ECECEA; --surface: #FAFAF9; --surface-2: #E0E0DD; --ink: #161616; --ink-muted: #5C5C59; --outline: #CDCDC9; --primary: #2C3F73; --mark: #2C3F73; --signal-ink: #2C3F73; --accent: #E3E7F1; }
      .og h1 { letter-spacing: -0.02em; line-height: 1.04; }
      .og .sub { font: 500 24px/1.3 var(--mono); color: var(--ink-muted); }
      .og .url { font: 700 24px/1 var(--mono); color: var(--signal-ink); }
      /* A: claim left, screenshot panel bleeding off the right edge */
      .og-a { background: var(--background); display: grid; grid-template-columns: 560px 1fr; }
      .og-a .text { padding: 64px 0 56px 64px; display: flex; flex-direction: column; gap: 28px; }
      .og-a .wordmark { height: 44px; align-self: flex-start; }
      .og-a h1 { font-size: 64px; margin-top: auto; }
      .og-a .shot { align-self: center; margin-left: 40px; width: 900px; background: var(--surface); border: 1px solid var(--outline); border-radius: 18px; padding: 14px; }
      .og-a .shot img { border-radius: 8px; width: 100%; }
      /* B: screenshot full bleed, claim band at the bottom */
      .og-b { background: var(--surface); }
      .og-b img { position: absolute; inset: 0 0 170px 0; width: 100%; height: 460px; object-fit: cover; object-position: center 40%; }
      .og-b .band { position: absolute; left: 0; right: 0; bottom: 0; height: 170px; background: var(--surface); border-top: 1px solid var(--outline); display: flex; align-items: center; justify-content: space-between; gap: 40px; padding: 0 56px; }
      .og-b .wordmark { height: 46px; flex: none; }
      .og-b h1 { font-size: 44px; text-align: right; }
      /* C: type only on ink blue, staff lines as the motif */
      .og-c { background: #2C3F73; --ink: #FFFFFF; --mark: #FFFFFF; color: #fff; padding: 72px; display: flex; flex-direction: column; justify-content: space-between; }
      .og-c .staff { position: absolute; left: 0; right: 0; top: 330px; display: grid; gap: 22px; opacity: .18; }
      .og-c .staff i { display: block; height: 3px; background: #fff; }
      .og-c .wordmark { height: 56px; position: relative; align-self: flex-start; }
      .og-c h1 { font-size: 76px; max-width: 980px; position: relative; }
      .og-c .row { display: flex; justify-content: space-between; align-items: end; position: relative; }
      .og-c .sub, .og-c .url { color: #C9D1EA; }
    </style>
  </head>
  <body>
    {variant === 'a' && (
      <div class="og og-a">
        <div class="text">
          <Wordmark class="wordmark" />
          <h1>{text.claim}</h1>
          <span class="sub">{text.sub}</span>
          <span class="url">stavewise.app</span>
        </div>
        <div class="shot"><Image src={shotDe} alt="" width={1280} format="webp" /></div>
      </div>
    )}
    {variant === 'b' && (
      <div class="og og-b">
        <Image src={shotDe} alt="" width={1280} format="webp" />
        <div class="band">
          <Wordmark class="wordmark" />
          <h1>{text.claim}</h1>
        </div>
      </div>
    )}
    {variant === 'c' && (
      <div class="og og-c">
        <div class="staff"><i></i><i></i><i></i><i></i><i></i></div>
        <Wordmark class="wordmark" />
        <h1>{text.claim}</h1>
        <div class="row"><span class="sub">{text.sub}</span><span class="url">stavewise.app</span></div>
      </div>
    )}
    <Switcher kind="og" variant={variant} />
  </body>
</html>
