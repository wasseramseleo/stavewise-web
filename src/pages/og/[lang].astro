---
// Source of the Open Graph preview image, one per language for all pages
// (launch § 14.5, variant A; stavewise#715). `npm run og` screenshots the
// element .og to public/og/stavewise-<lang>.png at 1200 x 630, always in the
// light app colours (the script renders with a light colour scheme).
// Not a page of the site: noindex, not in BUILT_PAGES, not in the sitemap.
import { Image } from 'astro:assets';
import '../../styles/tokens.css';
import '../../styles/base.css';
import Wordmark from '../../components/Wordmark.astro';
import { LANGS, type Lang } from '../../lib/i18n';
import { heroShot } from '../../lib/screenshots';
import { claimParts, home } from '../../texts/home';
import { og } from '../../texts/og';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
const claim = home[lang].heading;
const [lead, italic] = claimParts(home[lang]);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=1200" />
    <meta name="robots" content="noindex" />
    <title>{`Stavewise: ${claim}`}</title>
  </head>
  <body>
    <div class="og">
      <div class="text">
        <Wordmark class="wordmark" />
        <h1>{lead}<em>{italic}</em></h1>
        <span class="sub">{og[lang].subline}</span>
        <span class="url">stavewise.app</span>
      </div>
      <div class="shot">
        <Image src={heroShot[lang]} alt={home[lang].heroAlt} width={1280} format="webp" loading="eager" />
      </div>
    </div>
  </body>
</html>

<style is:global>
  body { margin: 0; }
  /* Claim left, screenshot card on the right, cut off by the right edge. */
  .og { width: 1200px; height: 630px; overflow: hidden; display: grid; grid-template-columns: 560px 1fr; background: var(--page); }
  .og .text { padding: 64px 0 56px 64px; display: flex; flex-direction: column; gap: 28px; }
  .og .wordmark { height: 44px; align-self: flex-start; }
  .og h1 { margin-top: auto; font-family: var(--serif); font-weight: 400; font-size: 66px; line-height: 1.04; letter-spacing: -0.015em; }
  .og h1 em { font-style: italic; }
  .og .sub { font: 500 24px/1.3 var(--mono); color: var(--ink-muted); }
  .og .url { font: 700 24px/1 var(--mono); color: var(--signal-ink); }
  .og .shot { align-self: center; width: 900px; margin-left: 40px; padding: 14px; background: var(--surface); border: 1px solid var(--outline); border-radius: 4px; }
  .og .shot img { display: block; width: 100%; height: auto; border-radius: 2px; }
</style>
