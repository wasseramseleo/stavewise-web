---
// Body of the beta page, shared by /de/beta and /en/beta (#597): the open test
// explained, the call for the closed test team below (launch § 15.8, variant C).
import PlayBadge from './PlayBadge.astro';
import { beta } from '../texts/beta';
import { pathOf, type Lang } from '../lib/i18n';
import { supportMail } from '../site';

interface Props {
  lang: Lang;
  /** Microsoft Forms link. */
  formUrl: string;
}

const { lang, formUrl } = Astro.props;
const t = beta[lang];
---
<div class="doc">
  <span class="label">{t.label}</span>
  <h1>{t.heading}</h1>
  <p>{t.lead}</p>
  <div class="btn-row"><PlayBadge lang={lang} /></div>
  <h2>{t.whatHeading}</h2>
  <ul>
    {t.what.map((point) => <li>{point}</li>)}
  </ul>
  <p>{t.feedbackBefore} <a class="mono" href={`mailto:${supportMail}`}>{supportMail}</a>{t.feedbackAfter}</p>
  <h2>{t.teamHeading}</h2>
  <div class="box beta-form">
    <p>{t.team}</p>
    <div class="btn-row">
      <a class="btn btn-main plain" href={formUrl} rel="noopener">{t.formButton}</a>
    </div>
    <p class="note">{t.privacyBefore}<a href={`${pathOf(lang, 'privacy')}#website`}>{t.privacyLink}</a>{t.privacyAfter}</p>
  </div>
</div>
