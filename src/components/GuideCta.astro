---
// Call to action at the end of a guide page (launch § 14.5 Nr. 8): the Play
// badge with the mono note beside it, the same as in the hero of the home page
// (launch § 15.8 Nr. 4).
import { guideShared } from '../texts/guide';
import { play } from '../texts/play';
import { pathOf, type Lang } from '../lib/i18n';
import PlayBadge from './PlayBadge.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = guideShared[lang];
---
<section class="card cta" aria-labelledby="cta-title">
  <span class="label">{t.ctaLabel}</span>
  <h2 id="cta-title">{t.ctaTitle}</h2>
  <p>{t.ctaText}</p>
  <div class="btn-row">
    <PlayBadge lang={lang} />
    <span class="cta-note">{play[lang].note}</span>
  </div>
  <p class="home-line">{t.homeLead} <a href={pathOf(lang, 'home')}>{t.homeLink} →</a></p>
</section>
