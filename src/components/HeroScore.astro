---
// Animated score in the hero of the home page (src/lib/score.ts): four bars
// wide, two bars on narrow screens; CSS shows one of the two.
import { buildScore } from '../lib/score';
import type { Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  label: string;
}

const { lang, label } = Astro.props;
const scores = [buildScore({ id: 'sw4', bars: 4, width: 1088, lang }), buildScore({ id: 'sw2', bars: 2, width: 360, lang })];
---
<div class="hero-score">
  {scores.map((score) => (
    <svg class={`score score-${score.bars}`} data-bars={score.bars} viewBox={score.viewBox} role="img" aria-label={label} xmlns="http://www.w3.org/2000/svg">
      <style set:html={score.css} />
      <Fragment set:html={score.markup} />
    </svg>
  ))}
</div>
