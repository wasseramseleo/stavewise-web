---
// Body of the home page /de/ and /en/ (variant B "Gerät", #545, #596); hero
// with the animated score (engraved score that behaves like an instrument).
import { Image } from 'astro:assets';
import '../styles/home.css';
import { claimParts, home } from '../texts/home';
import { pathOf, type Lang } from '../lib/i18n';
import HeroScore from './HeroScore.astro';
import PlayBadge from './PlayBadge.astro';
import { play } from '../texts/play';
import { supportMail } from '../site';
import exercise from '../assets/screenshots/de/exercise.png';
import resultDe from '../assets/screenshots/de/result.png';
import resultEn from '../assets/screenshots/en/result.png';
import statistics from '../assets/screenshots/de/statistics.png';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = home[lang];
const [claimLead, claimItalic] = claimParts(t);

// Placeholders: today's app goldens (phone, landscape), until the Roborazzi
// screenshots arrive. English uses the _en golden where one exists.
const shots = [
  { src: exercise, alt: t.shotAlts.exercise, caption: t.shotCaptions.exercise },
  { src: lang === 'en' ? resultEn : resultDe, alt: t.shotAlts.result, caption: t.shotCaptions.result },
  { src: statistics, alt: t.shotAlts.statistics, caption: t.shotCaptions.statistics },
];
---
<div class="home">
  <section class="wrap hero">
    <div class="hero-lead">
      <h1>{claimLead}<em>{claimItalic}</em></h1>
      <div class="hero-side">
        <p>{t.subline}</p>
        <div class="btn-row">
          <PlayBadge lang={lang} />
          <span class="cta-note">{play[lang].note}</span>
        </div>
      </div>
    </div>
    <HeroScore lang={lang} label={t.scoreLabel} />
  </section>

  <section class="wrap">
    <div class="readouts">
      {t.readouts.map((r) => (
        <div class="readout">
          <span class="label">{r.label}</span>
          <span class:list={["well", { word: r.spelled }]}>{r.value}</span>
          <small>{r.note}</small>
        </div>
      ))}
    </div>
  </section>

  <div class="wrap">
    <section class="section">
      <div class="section-head"><h2>{t.sheetTitle}</h2></div>
      <div class="sheet-box">
        <table class="sheet">
          <tbody>
            {t.sheet.map(([what, answer]) => (
              <tr><th scope="row">{what}</th><td>{answer}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section">
      <div class="section-head"><h2>{t.shotsTitle}</h2></div>
      <div class="shots">
        {shots.map((shot, i) => (
          <figure>
            <div class="panel">
              <Image src={shot.src} alt={shot.alt} width={720} widths={[360, 720]} sizes="(max-width: 820px) 100vw, 360px" format="webp" />
            </div>
            <figcaption><span class="num">{i + 1}</span> <span class="line">{shot.caption}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-head"><h2>{t.waysTitle}</h2></div>
      <div class="ways">
        {t.ways.map((way) => (
          <div class="card">
            <h3>{way.title} <span class="tag">{way.tag}</span></h3>
            <ol>
              {way.steps.map((step) => <li>{step}</li>)}
            </ol>
            <a class="card-foot" href={pathOf(lang, 'connect')}>{t.waysGuide} <span aria-hidden="true">→</span></a>
          </div>
        ))}
      </div>

      <div class="split">
        <div class="card price">
          <span class="label">{t.fullLabel}</span>
          <span class="well">{t.fullWell}</span>
          <p>{t.fullText}</p>
        </div>
        <div class="card">
          <span class="label">{t.teacherLabel}</span>
          <h3>{t.teacherTitle}</h3>
          <p>{t.teacherBefore} <a class="mono" href={`mailto:${supportMail}`}>{supportMail}</a>{t.teacherAfter}</p>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-head"><h2>{t.questionsTitle}</h2></div>
      <div class="faq">
        {t.questions.map((q, i) => (
          <details open={i === 0}>
            <summary>{q.question}</summary>
            <div>
              {q.answers.map((a) => <p>{a}</p>)}
              {i === 0 && (
                <p class="more">
                  <span class="label">{t.moreLabel}</span> <a href={pathOf(lang, 'connect')}>{t.moreConnect}</a> <a href={pathOf(lang, 'cable')}>{t.moreCable}</a>
                </p>
              )}
              {q.link && (
                <p class="more"><a href={pathOf(lang, q.link.page)}>{q.link.text}</a></p>
              )}
            </div>
          </details>
        ))}
      </div>
    </section>

    <div class="final" aria-hidden="true"></div>
  </div>
</div>
